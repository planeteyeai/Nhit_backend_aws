# Paste into your host’s environment UI (Railway, Render, Fly.io, etc.).
# Database can stay on Railway MySQL — use the SAME MYSQL_* as in the DB service dashboard.

NODE_ENV=production
PORT=3001
HOST=0.0.0.0

MYSQL_HOST=your-mysql-public-host.example.com
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-password
MYSQL_DATABASE=railway
MYSQL_SSL=1

JWT_SECRET=use-a-long-random-string-at-least-16-chars

# Deployed frontend URL(s), comma-separated — required in production
CORS_ORIGIN=https://your-frontend.up.railway.app,https://www.yourdomain.com

# Optional: only for debugging
# ENABLE_DIAG_API=false
