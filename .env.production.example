# Paste into your host’s environment UI (Railway, Render, Fly.io, etc.).
# Database can stay on Railway MySQL — use the SAME MYSQL_* as in the DB service dashboard.

NODE_ENV=production
PORT=3001
HOST=0.0.0.0

MYSQL_HOST=your-mysql-public-host.example.com
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-password
MYSQL_DATABASE=railway
MYSQL_SSL=1

JWT_SECRET=use-a-long-random-string-at-least-16-chars

# Deployed frontend URL(s), comma-separated — required in production
CORS_ORIGIN=https://your-frontend.up.railway.app,https://www.yourdomain.com

# Optional: only for debugging
# ENABLE_DIAG_API=false

# --- Railway Bucket (NHIT-bucket-bms) — use "+ Add to Service" on nhit-backend1 ---
# Or paste reference variables in Railway → nhit-backend1 → Variables:
#
# AWS_ENDPOINT_URL=${{ NHIT-bucket-bms.ENDPOINT }}
# AWS_S3_BUCKET_NAME=${{ NHIT-bucket-bms.BUCKET }}
# AWS_DEFAULT_REGION=${{ NHIT-bucket-bms.REGION }}
# AWS_ACCESS_KEY_ID=${{ NHIT-bucket-bms.ACCESS_KEY_ID }}
# AWS_SECRET_ACCESS_KEY=${{ NHIT-bucket-bms.SECRET_ACCESS_KEY }}
#
# Manual values (if not using references):
# AWS_ENDPOINT_URL=https://t3.storageapi.dev
# AWS_DEFAULT_REGION=auto
# AWS_S3_BUCKET_NAME=nhit-bucket-bms-y8pfmqurd
# AWS_ACCESS_KEY_ID=<from Credentials tab>
# AWS_SECRET_ACCESS_KEY=<from Credentials tab>
PRESIGNED_URL_EXPIRY_SEC=3600

# Catalog GLB sync (until all models are in bucket)
GITHUB_LFS_REPO=planeteyeai/nhit-backend1
GITHUB_TOKEN=
