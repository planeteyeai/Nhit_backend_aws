AWS_S3_REGION_NAME=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=

# Public viewer base URL (used for Public viewer links — not localhost)
# Optional. Defaults to http://localhost:3000. Set on Vercel for production links.
# PUBLIC_VIEWER_ORIGIN=https://pointcloud-viewer-nine.vercel.app

# Local PotreeConverter (defaults to bundled Windows exe if empty)
# POTREE_CONVERTER_PATH=las to poctree converter/PotreeConverter.exe

# S3 prefix for LAS/LAZ source files (bulk publish scans this prefix)
SOURCE_LAS_PREFIX=upload/model_3d/
# Legacy alias still supported: BULK_LAS_PREFIX=upload/model_3d/

# S3 prefix root for converted Potree output (files go to {prefix}{id}/)
POTREE_OUTPUT_PREFIX=upload/potree/

# Dev server bind (0.0.0.0 = LAN access). Optional LAN_IP for startup display.
# HOST=0.0.0.0
# PORT=3000
# LAN_IP=192.168.42.69
