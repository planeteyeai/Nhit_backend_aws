# ─── Server ───────────────────────────────────────────
NODE_ENV=production
PORT=8080
HOST=0.0.0.0

# Public API base URL (used in logs — set to your ALB DNS or custom domain)
PUBLIC_API_URL=https://nhit-alb-xxxxxxx.ap-south-1.elb.amazonaws.com

# ─── MySQL (RDS) ───────────────────────────────────────
MYSQL_HOST=nhit-db.xxxxxxx.ap-south-1.rds.amazonaws.com
MYSQL_PORT=3306
MYSQL_USER=admin
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=nhit_db

# Enable SSL for RDS (recommended for production)
MYSQL_SSL=true
MYSQL_SSL_REJECT_UNAUTHORIZED=true

# ─── Auth ──────────────────────────────────────────────
# Minimum 32 characters, random string
JWT_SECRET=change-me-use-a-long-random-string-here

# ─── CORS ──────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=https://your-app.onrender.com

# ─── AWS S3 (file uploads) ─────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=change-me
AWS_SECRET_ACCESS_KEY=change-me
S3_BUCKET=nhit-uploads

# ─── Point Cloud Viewer (optional) ────────────────────
POINTCLOUD_VIEWER_ORIGINS=
