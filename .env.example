# Copy to .env and fill real values. Never commit .env.

PORT=8080
HOST=0.0.0.0
NODE_ENV=production

# --- Database (AWS RDS) ---
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
MYSQL_SSL=1
MYSQL_SSL_REJECT_UNAUTHORIZED=false

# --- Auth (required in production; min 16 chars, not a placeholder) ---
JWT_SECRET=

# --- CORS (comma-separated frontend origins) ---
CORS_ORIGIN=https://your-frontend.example

# --- Optional ---
# PUBLIC_API_URL=https://your-api.example
# POINTCLOUD_VIEWER_ORIGINS=
# AWS_REGION=
# AWS_S3_BUCKET=
