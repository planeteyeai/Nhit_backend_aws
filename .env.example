PORT=3001
MYSQL_HOST=your-host.example.com
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=railway
# Set to 1 if your host requires TLS (common on Railway / cloud MySQL)
MYSQL_SSL=0
JWT_SECRET=change-me-in-production
# Comma-separated list of allowed frontend origins
# Example: CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGIN=http://localhost:5173
# Listen interface for LAN access (use 0.0.0.0 for other devices)
HOST=0.0.0.0
