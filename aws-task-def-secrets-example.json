{
  "containerDefinitions": [
    {
      "name": "nhit-backend",
      "secrets": [
        {
          "name": "MYSQL_HOST",
          "valueFrom": "arn:aws:secretsmanager:ap-south-1:529990093872:secret:nhit-backend-env:MYSQL_HOST::"
        },
        {
          "name": "MYSQL_USER",
          "valueFrom": "arn:aws:secretsmanager:ap-south-1:529990093872:secret:nhit-backend-env:MYSQL_USER::"
        },
        {
          "name": "MYSQL_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:ap-south-1:529990093872:secret:nhit-backend-env:MYSQL_PASSWORD::"
        },
        {
          "name": "MYSQL_DATABASE",
          "valueFrom": "arn:aws:secretsmanager:ap-south-1:529990093872:secret:nhit-backend-env:MYSQL_DATABASE::"
        },
        {
          "name": "JWT_SECRET",
          "valueFrom": "arn:aws:secretsmanager:ap-south-1:529990093872:secret:nhit-backend-env:JWT_SECRET::"
        },
        {
          "name": "CORS_ORIGIN",
          "valueFrom": "arn:aws:secretsmanager:ap-south-1:529990093872:secret:nhit-backend-env:CORS_ORIGIN::"
        },
        {
          "name": "AWS_REGION",
          "valueFrom": "arn:aws:secretsmanager:ap-south-1:529990093872:secret:nhit-backend-env:AWS_REGION::"
        },
        {
          "name": "S3_BUCKET",
          "valueFrom": "arn:aws:secretsmanager:ap-south-1:529990093872:secret:nhit-backend-env:S3_BUCKET::"
        },
        {
          "name": "PUBLIC_API_URL",
          "valueFrom": "arn:aws:secretsmanager:ap-south-1:529990093872:secret:nhit-backend-env:PUBLIC_API_URL::"
        }
      ],
      "environment": [
        {
          "name": "NODE_ENV",
          "value": "production"
        },
        {
          "name": "PORT",
          "value": "8080"
        },
        {
          "name": "HOST",
          "value": "0.0.0.0"
        },
        {
          "name": "MYSQL_PORT",
          "value": "3306"
        },
        {
          "name": "MYSQL_SSL",
          "value": "true"
        }
      ]
    }
  ]
}
